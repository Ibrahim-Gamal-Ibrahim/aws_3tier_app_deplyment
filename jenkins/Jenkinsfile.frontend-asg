pipeline {
    agent any

    parameters {
        string(
            name: 'INSTANCE_ID',
            defaultValue: '',
            description: 'Frontend EC2 instance ID launched by the Auto Scaling Group'
        )
    }

    environment {
        AWS_REGION = 'eu-north-1'
        ASG_NAME = 'frontend-asg'
        LIFECYCLE_HOOK_NAME = 'frontend-configuration-hook'
        BACKEND_ALB_NAME = 'backend-internal-alb'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Ibrahim-Gamal-Ibrahim/aws_3tier_app_deplyment.git'
            }
        }

        stage('Validate Input') {
            steps {
                script {
                    if (!params.INSTANCE_ID?.trim()) {
                        error('INSTANCE_ID was not provided')
                    }

                    echo "Frontend instance ID: ${params.INSTANCE_ID}"
                }
            }
        }

        stage('Get Frontend Private IP') {
            steps {
                script {
                    env.NEW_FRONTEND_IP = sh(
                        script: """
                            aws ec2 describe-instances \
                              --region ${env.AWS_REGION} \
                              --instance-ids ${params.INSTANCE_ID} \
                              --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                              --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!env.NEW_FRONTEND_IP ||
                        env.NEW_FRONTEND_IP == 'None') {

                        error(
                            "Could not resolve private IP for ${params.INSTANCE_ID}"
                        )
                    }

                    echo "Frontend private IP: ${env.NEW_FRONTEND_IP}"
                }
            }
        }

        stage('Get Backend ALB DNS') {
            steps {
                script {
                    env.BACKEND_ALB_DNS = sh(
                        script: """
                            aws elbv2 describe-load-balancers \
                              --names ${env.BACKEND_ALB_NAME} \
                              --region ${env.AWS_REGION} \
                              --query 'LoadBalancers[0].DNSName' \
                              --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!env.BACKEND_ALB_DNS ||
                        env.BACKEND_ALB_DNS == 'None') {

                        error('Could not resolve backend internal ALB DNS')
                    }

                    echo "Backend ALB DNS: ${env.BACKEND_ALB_DNS}"
                }
            }
        }

        stage('Test SSH') {
            steps {
                sshagent(credentials: ['backend-ssh-key']) {
                    retry(6) {
                        sh '''
                            sleep 10

                            ssh \
                              -o StrictHostKeyChecking=no \
                              -o ConnectTimeout=10 \
                              ubuntu@$NEW_FRONTEND_IP \
                              "hostname && whoami"
                        '''
                    }
                }
            }
        }

        stage('Run Frontend Ansible Role') {
            steps {
                sshagent(credentials: ['backend-ssh-key']) {
                    sh '''
                        cd ansible

                        ansible-playbook site.yml \
                          --limit "$NEW_FRONTEND_IP" \
                          -e "backend_alb_dns=$BACKEND_ALB_DNS" \
                          -e 'ansible_ssh_common_args='
                    '''
                }
            }
        }

        stage('Verify Nginx Service') {
            steps {
                sshagent(credentials: ['backend-ssh-key']) {
                    sh '''
                        ssh \
                          -o StrictHostKeyChecking=no \
                          ubuntu@$NEW_FRONTEND_IP \
                          "systemctl is-active nginx"
                    '''
                }
            }
        }

        stage('Verify Nginx Configuration') {
            steps {
                sshagent(credentials: ['backend-ssh-key']) {
                    sh '''
                        ssh \
                          -o StrictHostKeyChecking=no \
                          ubuntu@$NEW_FRONTEND_IP \
                          "sudo nginx -t"
                    '''
                }
            }
        }

        stage('Verify Frontend HTTP') {
            steps {
                sshagent(credentials: ['backend-ssh-key']) {
                    retry(5) {
                        sh '''
                            sleep 5

                            ssh \
                              -o StrictHostKeyChecking=no \
                              ubuntu@$NEW_FRONTEND_IP \
                              "curl -f http://127.0.0.1/"
                        '''
                    }
                }
            }
        }

        stage('Complete Lifecycle Hook') {
            steps {
                sh """
                    aws autoscaling complete-lifecycle-action \
                      --lifecycle-hook-name ${env.LIFECYCLE_HOOK_NAME} \
                      --auto-scaling-group-name ${env.ASG_NAME} \
                      --lifecycle-action-result CONTINUE \
                      --instance-id ${params.INSTANCE_ID} \
                      --region ${env.AWS_REGION}
                """
            }
        }
    }

    post {
        success {
            echo "Frontend instance ${params.INSTANCE_ID} configured successfully."
            echo "Backend ALB used: ${env.BACKEND_ALB_DNS}"
            echo "Lifecycle action completed with CONTINUE."
        }

        failure {
            echo "Frontend pipeline failed."
            echo "Lifecycle action was NOT completed."
            echo "The EC2 instance should remain in Pending:Wait until timeout."
        }
    }
}